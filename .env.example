# Optional. Poshmark public search works without a key. Set false for offline tests.
POSHMARK_PUBLIC_SEARCH=true
# Leave paid keys blank to use Poshmark, research references and marketplace links.
# Recommended: server-side eBay application token acquisition.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Legacy option if no client pair is set; expiry then requires manual replacement.
EBAY_ACCESS_TOKEN=
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Result caching is OFF by default. Enable only if your provider agreement allows storage.
# Values are seconds, capped at 300. Images are never cached by the app.
EBAY_STORAGE_ALLOWED=false
EBAY_CACHE_TTL_SECONDS=0
BRAVE_STORAGE_ALLOWED=false
BRAVE_CACHE_TTL_SECONDS=0
